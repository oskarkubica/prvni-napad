<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nástěnka vzkazů</title>
  <style>
    :root{
      --bg1:#f8fafc;
      --bg2:#ffffff;
      --bg3:#f1f5f9;

      --card:#ffffff;
      --border:#e2e8f0;
      --text:#0f172a;
      --muted:#64748b;

      --accent:#10b981;
      --danger:#e11d48;

      --note:#fffbeb;
      --noteBorder:#fde68a;
      --noteText:#0f172a;

      --radius:18px;
      --shadow: 0 10px 25px rgba(15,23,42,.07), 0 1px 2px rgba(15,23,42,.08);
    }

    *{ box-sizing: border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      color: var(--text);
      background: radial-gradient(1200px 600px at 20% 0%, var(--bg2), transparent 60%),
                  radial-gradient(900px 500px at 90% 10%, var(--bg2), transparent 55%),
                  linear-gradient(135deg, var(--bg1), var(--bg2), var(--bg3));
    }

    .wrap{
      max-width: 1200px;
      margin: 0 auto;
      padding: 18px;
    }

    .grid{
      display:grid;
      gap: 16px;
      grid-template-columns: 420px 1fr;
      align-items: start;
    }

    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
    }

    .card{
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 16px;
    }

    h1{
      font-size: 20px;
      margin: 0 0 4px 0;
    }
    .sub{
      margin:0;
      font-size: 14px;
      color: var(--muted);
      line-height: 1.4;
    }

    label{
      display:block;
      margin-top: 14px;
      font-size: 13px;
      font-weight: 600;
    }

    textarea{
      width: 100%;
      margin-top: 8px;
      min-height: 110px;
      resize: vertical;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 12px;
      font-size: 14px;
      outline: none;
    }
    textarea:focus{
      border-color: rgba(16,185,129,.35);
      box-shadow: 0 0 0 4px rgba(16,185,129,.14);
    }

    .row{
      display:flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .btn{
      border: 0;
      border-radius: 999px;
      padding: 10px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: transform .05s ease, opacity .15s ease, background .15s ease;
      user-select:none;
    }
    .btn:active{ transform: translateY(1px); }
    .btn:disabled{ opacity: .45; cursor: not-allowed; }

    .btn.primary{ background:#0f172a; color: #fff; }
    .btn.secondary{ background:#f1f5f9; color:#0f172a; }
    .btn.danger{ background: var(--danger); color: #fff; }

    .meta{
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      display:flex;
      align-items:center;
      gap: 8px;
    }
    .dot{
      width: 8px; height: 8px;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 0 4px rgba(16,185,129,.15);
    }

    .tip{
      margin-top: 14px;
      border-radius: var(--radius);
      background: #f8fafc;
      border: 1px solid #eef2f7;
      padding: 12px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
    }

    /* Board */
    .board{
      position: relative;
      height: 72vh;
      min-height: 520px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: #fff;
      box-shadow: var(--shadow);
      overflow: hidden;
      cursor: default;
    }
    .board.placing{
      cursor: crosshair;
      border-color: rgba(16,185,129,.5);
    }

    .boardHint{
      position:absolute;
      left: 14px;
      top: 14px;
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid rgba(16,185,129,.25);
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 12px;
      pointer-events:none;
    }

    .empty{
      position:absolute;
      inset:0;
      display:grid;
      place-items:center;
      text-align:center;
      color: var(--muted);
      padding: 20px;
    }
    .empty .icon{
      width: 44px; height:44px;
      border-radius: 14px;
      background:#f1f5f9;
      margin: 0 auto 8px auto;
    }
    .empty .t1{ font-size: 14px; font-weight: 700; color: var(--text); }
    .empty .t2{ font-size: 12px; margin-top: 2px; }

